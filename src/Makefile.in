	-rm -f ./$(DEPDIR)/cmdg-gtk2_font.Po
	-rm -f ./$(DEPDIR)/cmdg-gtk2_windowing.Po
	-rm -f ./$(DEPDIR)/cmdg-image_backlog.Po
	-rm -f ./$(DEPDIR)/cmdg-on_ptout.Po
	-rm -f ./$(DEPDIR)/cmdg-pseudo_vt100.Po
	-rm -f ./$(DEPDIR)/cmdg-unicode.Po
	-rm -f ./$(DEPDIR)/cmdg-vt100_parser.Po
	-rm -f helper/$(DEPDIR)/cmdg-pow2_ge.Po
	-rm -f Makefile
distclean-am: clean-am distclean-compile distclean-generic \
	distclean-tags

